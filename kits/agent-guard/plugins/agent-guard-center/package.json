{
  "name": "@itharbors/agent-guard-center",
  "version": "0.0.1",
  "type": "module",
  "dependencies": {
    "@itharbors/agent-guard-contracts": "file:../../packages/contracts"
  },
  "main": "./main/dist/index.js",
  "ce-editor": {
    "contribute": {
      "panel": {
        "guard": {
          "entry": "./panel.guard/dist/index.html",
          "title": "Agent Guard",
          "minWidth": 720,
          "minHeight": 520,
          "multiInstance": false
        }
      },
      "message": {
        "request": {
          "getSnapshot": ["getSnapshot"],
          "updatePolicy": ["updatePolicy"],
          "executeCommand": ["executeCommand"],
          "getIncidents": ["getIncidents"],
          "openGuardPanel": ["openGuardPanel"]
        }
      },
      "menu": [
        {
          "type": "menu",
          "id": "view/panels/agent-guard",
          "message": "openGuardPanel",
          "order": 900,
          "label": "Agent Guard"
        }
      ]
    }
  }
}
