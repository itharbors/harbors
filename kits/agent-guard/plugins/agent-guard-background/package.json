{
  "name": "@itharbors/agent-guard-background",
  "version": "0.0.1",
  "type": "module",
  "dependencies": {
    "@itharbors/agent-guard-contracts": "file:../../packages/contracts"
  },
  "main": "./main/dist/index.js",
  "ce-editor": {
    "assets": {
      "public": ["resources"]
    },
    "contribute": {
      "message": {
        "request": {
          "getSnapshot": ["getSnapshot"],
          "updatePolicy": ["updatePolicy"],
          "executeCommand": ["executeCommand"],
          "getIncidents": ["getIncidents"],
          "getTrafficHistory": ["getTrafficHistory"],
          "getHistoryStatus": ["getHistoryStatus"],
          "updateHistorySettings": ["updateHistorySettings"],
          "clearHistory": ["clearHistory"]
        }
      }
    }
  }
}
