{
  "name": "@itharbors/kit-agent-guard",
  "version": "0.1.0-preview.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "node ../../packages/kit-cli/dist/cli.js build .",
    "test:kit": "vitest run --config vitest.config.ts",
    "test": "npm run test:kit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@itharbors/agent-guard-contracts": "file:packages/contracts"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "ce-editor": {
    "kit": {
      "menuRoot": {
        "id": "agent-guard",
        "label": "Agent Guard"
      },
      "layouts": {
        "default": "layout.json"
      },
      "windowEntries": {
        "main": "main.html",
        "secondary": "secondary.html"
      },
      "startup": {
        "plugins": ["@itharbors/agent-guard-background"]
      },
      "plugin": ["@itharbors/agent-guard-center"],
      "theme": {
        "--ce-accent": "#ff8a3d"
      }
    }
  },
  "harbors": {
    "distribution": "market",
    "ci": { "runner": "macos-14" },
    "docs": { "summary": "Claude Code 与 Codex 的本机零配置流量监控、异常预警和安全熔断" },
    "resources": [],
    "storage": { "legacyDataDirectories": ["agent-guard"] },
    "scripts": {
      "build": "build",
      "test": "test:kit",
      "smoke": "smoke"
    }
  }
}
