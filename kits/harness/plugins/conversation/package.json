{
  "name": "conversation",
  "version": "0.0.1",
  "type": "module",
  "main": "./main/dist/index.js",
  "ce-editor": {
    "schemaVersion": 1,
    "contribute": {
      "panel": {
        "list": {
          "entry": "./panel.list/dist/index.html",
          "title": "对话列表",
          "width": 280,
          "minWidth": 200
        },
        "settings": {
          "entry": "./panel.settings/dist/index.html",
          "title": "对话设置",
          "width": 520,
          "minWidth": 280
        }
      },
      "settings": {
        "schemaVersion": 3,
        "panel": "settings",
        "order": 20
      },
      "message": {
        "request": {
          "getState": ["getState"],
          "select": ["select"],
          "listArchivedConversations": ["listArchivedConversations"],
          "archiveConversation": ["archiveConversation"],
          "restoreConversation": ["restoreConversation"],
          "deleteArchivedConversation": { "methods": ["deleteArchivedConversation"], "callers": ["conversation"] },
          "listKnownProjects": { "methods": ["listKnownProjects"], "callers": ["chat"] }
        },
        "broadcast": {
          "agent.conversation.changed": ["onConversationChanged", "panel.onConversationChanged"],
          "conversation.selected": ["panel.onConversationSelected"]
        }
      }
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@chatscope/chat-ui-kit-react": "^2.1.1",
    "@chatscope/chat-ui-kit-styles": "^1.4.0"
  }
}
