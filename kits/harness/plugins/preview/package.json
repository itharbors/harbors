{
  "name": "preview",
  "version": "0.0.1",
  "type": "module",
  "main": "./main/dist/index.js",
  "ce-editor": {
    "schemaVersion": 1,
    "contribute": {
      "panel": {
        "preview": {
          "entry": "./panel.preview/dist/index.html",
          "title": "预览"
        }
      },
      "message": {
        "request": {
          "readFile": ["readFile"],
          "openProxyPage": ["openProxyPage"],
          "closeProxyPage": ["closeProxyPage"],
          "openPreviewPanel": ["openPreviewPanel"],
          "getLocalPreviewPanel": ["getLocalPreviewPanel"]
        },
        "broadcast": {
          "chat.link.clicked": ["panel.onLinkClicked"],
          "conversation.selected": ["panel.onConversationSelected"]
        }
      },
      "menu": [
        {
          "type": "menu",
          "id": "view/panels/ce-preview-preview",
          "message": "openPreviewPanel",
          "localMessage": "getLocalPreviewPanel",
          "order": 990,
          "label": "预览"
        }
      ]
    }
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  }
}
