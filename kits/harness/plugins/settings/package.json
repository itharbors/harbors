{
  "name": "settings",
  "version": "0.0.1",
  "type": "module",
  "main": "./main/dist/index.js",
  "ce-editor": {
    "contribute": {
      "panel": {
        "settings": {
          "entry": "./panel.settings/dist/index.html",
          "title": "设置"
        }
      },
      "message": {
        "request": {
          "getPages": ["getPages"],
          "openSettingsPanel": ["openSettingsPanel"]
        },
        "broadcast": {
          "settings.registry.changed": ["panel.onRegistryChanged"]
        }
      },
      "menu": [
        {
          "type": "menu",
          "id": "view/panels/ce-settings-settings",
          "message": "openSettingsPanel",
          "order": 1000,
          "label": "设置"
        }
      ]
    }
  }
}
