{
  "name": "harness",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node ../../packages/kit-cli/dist/cli.js build .",
    "test:kit": "node ../../packages/kit-cli/dist/cli.js validate . && pnpm run test:unit && pnpm run test:plugin && pnpm run test:assembly",
    "test:unit": "pnpm run build && pnpm run test:unit:run",
    "test:unit:run": "pnpm --dir ../.. exec tsx --test \"kits/harness/plugins/**/{main/src,panel.*/src}/**/*.test.{ts,tsx}\" \"kits/harness/plugins/*/*.test.{ts,tsx}\"",
    "test:plugin": "pnpm --dir ../../packages/server exec vitest run --root ../../kits/harness --config ../../kits/harness/vitest.config.ts plugins/conversation/tests/runtime.smoke.test.ts",
    "test:assembly": "pnpm --dir ../../packages/server exec vitest run --root ../../kits/harness --config ../../kits/harness/vitest.config.ts tests/assembly.test.ts",
    "smoke": "node tests/web-host.smoke.mjs"
  },
  "ce-editor": {
    "kit": {
      "menuRoot": {
        "id": "harness",
        "label": "Harbors Harness"
      },
      "layouts": {
        "default": "layout.json"
      },
      "windowEntries": {
        "main": "main.html",
        "secondary": "secondary.html"
      },
      "plugin": [
        "conversation",
        "chat",
        "model-service",
        "agent",
        "plugin",
        "preview",
        "debug",
        "settings",
        "mermaid"
      ]
    }
  },
  "harbors": {
    "distribution": "builtin",
    "ci": { "runner": "ubuntu-latest" },
    "docs": { "summary": "Harbors Harness AI Agent 工作台 Kit，提供对话、执行、模型服务、预览与调试能力" },
    "resources": [],
    "storage": {
      "legacyDataDirectories": [],
      "legacyPluginDataDirectories": { "agent": ["pi-agent"] }
    },
    "scripts": {
      "build": "build",
      "test": "test:kit",
      "smoke": "smoke"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.33.0",
      "nanoid": "3.3.18"
    }
  }
}
