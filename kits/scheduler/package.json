{
  "name": "@itharbors/kit-scheduler",
  "version": "0.1.0-preview.2",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/ce-plugin.mjs build plugins/scheduler-service && node ../../scripts/ce-plugin.mjs build plugins/scheduler-panel",
    "test": "vitest run --config vitest.config.ts"
  },
  "ce-editor": {
    "kit": {
      "menuRoot": {
        "id": "scheduler",
        "label": "Scheduler"
      },
      "layouts": {
        "default": "layout.json"
      },
      "windowEntries": {
        "main": "main.html",
        "secondary": "secondary.html"
      },
      "startup": {
        "plugins": [
          "@itharbors/scheduler-service"
        ]
      },
      "plugin": [
        "@itharbors/scheduler-panel"
      ],
      "theme": {
        "--ce-accent": "#1b6688"
      }
    }
  },
  "harbors": {
    "distribution": "market",
    "ci": { "runner": "ubuntu-latest" },
    "docs": { "summary": "本地 Node.js 脚本的定时、循环与错过触发管理" },
    "resources": [],
    "storage": { "legacyDataDirectories": [] },
    "scripts": {
      "build": "build",
      "test": "test"
    }
  }
}
