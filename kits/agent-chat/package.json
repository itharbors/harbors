{
  "name": "agent-chat",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node ../../packages/kit-cli/dist/cli.js build .",
    "test:kit": "node ../../packages/kit-cli/dist/cli.js validate ."
  },
  "ce-editor": {
    "kit": {
      "menuRoot": {
        "id": "agent-chat",
        "label": "Agent Chat"
      },
      "layouts": {
        "default": "layout.json"
      },
      "windowEntries": {
        "main": "main.html",
        "secondary": "secondary.html"
      },
      "plugin": [
        "conversation",
        "message-panel",
        "agent",
        "plugin-list",
        "preview",
        "debug",
        "settings"
      ]
    }
  },
  "harbors": {
    "distribution": "builtin",
    "ci": { "runner": "ubuntu-latest" },
    "docs": { "summary": "AI 对话工作台 Kit，提供对话列表与消息界面，后端对接 Harbors agent" },
    "resources": [],
    "storage": { "legacyDataDirectories": [] },
    "scripts": {
      "build": "build",
      "test": "test:kit"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.33.0",
      "nanoid": "3.3.18"
    }
  }
}
