{
  "schemaVersion": 1,
  "id": "agent-chat",
  "version": "0.0.1",
  "channel": "stable",
  "publisher": "itharbors",
  "requires": {
    "harbors": ">=0.0.1 <0.1.0",
    "kitApi": "^1.0.0",
    "protocolVersion": 1
  },
  "target": { "platform": "any", "arch": "any" },
  "permissions": ["credentials"],
  "permissionGrants": { "credentials": ["model-service"] },
  "config": {
    "schemaVersion": 1,
    "defaultsLayer": "default",
    "writeLayer": "global",
    "layers": [
      { "name": "default", "priority": 0, "storage": null },
      {
        "name": "global",
        "priority": 10,
        "storage": { "driver": "sqlite", "root": "application-data", "path": "config.sqlite" }
      }
    ]
  },
  "entry": "package.json"
}
