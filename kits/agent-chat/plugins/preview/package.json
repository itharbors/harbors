{
  "name": "preview",
  "version": "0.0.1",
  "type": "module",
  "main": "./main/dist/index.js",
  "ce-editor": {
    "contribute": {
      "panel": {
        "preview": {
          "entry": "./panel.preview/dist/index.html",
          "title": "预览"
        }
      },
      "message": {
        "request": {
          "readFile": ["readFile"]
        },
        "broadcast": {
