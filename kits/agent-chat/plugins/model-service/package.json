{
  "name": "model-service",
  "version": "0.0.1",
  "type": "module",
  "main": "./main/dist/index.js",
  "ce-editor": {
    "capabilities": ["credentials"],
    "contribute": {
      "panel": {
        "settings": {
          "entry": "./panel.settings/dist/index.html",
          "title": "模型服务设置"
        }
      },
      "settings": {
        "schemaVersion": 2,
        "panel": "settings",
        "title": "模型服务",
        "order": 20,
        "requests": ["getSettings", "saveProvider", "deleteProvider", "resetProviderCredential"]
      },
      "message": {
        "request": {
          "getCatalog": ["getCatalog"],
          "getSettings": { "methods": ["getSettings"], "callers": ["settings"] },
          "saveProvider": { "methods": ["saveProvider"], "callers": ["settings"] },
          "deleteProvider": { "methods": ["deleteProvider"], "callers": ["settings"] },
          "resetProviderCredential": { "methods": ["resetProviderCredential"], "callers": ["settings"] },
          "webSearch": ["webSearch"],
          "complete": ["complete"],
          "cancel": ["cancel"]
        }
      }
    }
  }
}
