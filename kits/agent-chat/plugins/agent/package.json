{
  "name": "agent",
  "version": "0.0.1",
  "type": "module",
  "main": "./main/dist/index.cjs",
  "ce-editor": {
    "contribute": {
      "panel": {
        "settings": {
          "entry": "./panel.settings/dist/index.html",
          "title": "Agent 设置"
        }
      },
      "settings": {
        "schemaVersion": 3,
        "panel": "settings",
        "order": 10
      },
      "message": {
        "request": {
          "listConversations": ["listConversations"],
          "listDirectory": ["listDirectory"],
          "getDraftOptions": ["getDraftOptions"],
          "getSettings": { "methods": ["getSettings"], "callers": ["agent"] },
          "saveSettings": { "methods": ["saveSettings"], "callers": ["agent"] },
          "resetSettings": { "methods": ["resetSettings"], "callers": ["agent"] },
          "getConversationOptions": ["getConversationOptions"],
          "getConversationContext": ["getConversationContext"],
          "getConversationPermissions": ["getConversationPermissions"],
          "setConversationPermissions": ["setConversationPermissions"],
          "getPendingPermissionRequests": ["getPendingPermissionRequests"],
          "resolvePermissionRequest": ["resolvePermissionRequest"],
          "createConversation": ["createConversation"],
          "deleteConversation": ["deleteConversation"],
          "renameConversation": ["renameConversation"],
          "getConversationTrace": ["getConversationTrace"],
          "getConversationTraceSince": ["getConversationTraceSince"],
          "getConversationTracePage": ["getConversationTracePage"],
          "sendMessage": ["sendMessage"],
          "stopConversation": ["stopConversation"]
        }
      }
    }
  }
}
