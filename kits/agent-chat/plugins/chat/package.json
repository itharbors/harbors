{
  "name": "chat",
  "version": "0.0.1",
  "type": "module",
  "main": "./main/dist/index.js",
  "scripts": {
    "build": "postcss ./panel.main/src/styles.css -o ./panel.main/src/index.css"
  },
  "ce-editor": {
    "contribute": {
      "panel": {
        "main": {
          "entry": "./panel.main/dist/index.html",
          "title": "对话"
        }
      },
      "message": {
        "request": {
          "normalizeLink": ["normalizeLink"]
        },
        "broadcast": {
          "agent.conversation.changed": [
            "panel.onConversationChanged"
          ],
          "conversation.selected": [
            "panel.onConversationSelected"
          ],
          "agent.conversation.trace.append": [
            "panel.onConversationTraceAppend"
          ],
          "agent.message.delta": [
            "panel.onMessageDelta"
          ],
          "agent.message.status": [
            "panel.onMessageStatus"
          ],
          "model-service.catalog.changed": [
            "panel.onModelCatalogChanged"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.69",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "lightningcss": "npm:lightningcss-wasm@^1.33.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.3.3"
  }
}
