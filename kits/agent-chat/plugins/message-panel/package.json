{
  "name": "message-panel",
  "version": "0.0.1",
  "type": "module",
  "main": "./main/dist/index.js",
  "ce-editor": {
    "contribute": {
      "panel": {
        "main": {
          "entry": "./panel.main/dist/index.html",
          "title": "对话"
        }
      },
      "message": {
        "broadcast": {
          "conversation.changed": [
            "panel.onConversationChanged"
          ],
          "conversation.ui.changed": [
            "panel.onConversationUiChanged"
          ],
          "message.delta": [
            "panel.onMessageDelta"
          ],
          "message.status": [
            "panel.onMessageStatus"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@chatscope/chat-ui-kit-react": "^2.1.1",
    "@chatscope/chat-ui-kit-styles": "^1.4.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
