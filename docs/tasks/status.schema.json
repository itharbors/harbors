{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "type", "updatedAt", "stages", "pullRequest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "enum": ["feature", "bug", "optimize", "docs", "refactor", "test", "chore"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "design", "implementation", "verification", "consolidation"],
      "properties": {
        "requirements": { "$ref": "#/$defs/stage" },
        "design": { "$ref": "#/$defs/stage" },
        "implementation": { "$ref": "#/$defs/stage" },
        "verification": { "$ref": "#/$defs/stage" },
        "consolidation": { "$ref": "#/$defs/stage" }
      }
    },
    "pullRequest": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["number"],
          "properties": { "number": { "type": "integer", "minimum": 1 } }
        }
      ]
    }
  },
  "$defs": {
    "stage": { "enum": ["pending", "in_progress", "completed", "blocked", "skipped"] }
  }
}
